meta {
  name: Overlapping tier is rejected
  type: http
  seq: 12
}

post {
  url: {{paymentUrl}}/services/{{serviceCode}}/commands/PAYMENT/tiers
  body: json
  auth: none
}

body:json {
  {
    "minAmount": "10.00",
    "maxAmount": "20.00",
