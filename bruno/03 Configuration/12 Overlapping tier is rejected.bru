    "movements": [
      {
        "movementSequence": 1,
        "amountType": "AMOUNT",
        "fromStockRole": "PAYER",
        "toStockRole": "PAYEE"
      }
    ]
  }
}

tests {
  test("status is 409", function () {
    expect(res.status).to.equal(409);
  });
