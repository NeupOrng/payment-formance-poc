meta {
  name: Create profile without KYC
  type: http
  seq: 3
}

post {
  url: {{profileUrl}}/profiles
  body: json
  auth: none
}

body:json {
  {
    "profileType": "INDIVIDUAL",
    "fullName": "Bruno No KYC"
  }
}

script:post-response {
  bru.setVar("noKycId", res.body.id);
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("PENDING_KYC", function () {
    expect(res.body.status).to.equal("PENDING_KYC");
  });
}
