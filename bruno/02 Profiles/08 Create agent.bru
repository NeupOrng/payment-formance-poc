meta {
  name: Create agent
  type: http
  seq: 8
}

post {
  url: {{profileUrl}}/profiles
  body: json
  auth: none
}

body:json {
  {
    "profileType": "AGENT",
    "fullName": "Bruno Agent",
    "kycVerified": true,
    "currencies": [
      "USD"
    ]
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("AGENT_FLOAT and COMMISSION accounts", function () {
    expect(res.body.accounts.map((a) => a.productType).sort()).to.eql(["AGENT_FLOAT", "COMMISSION"]);
  });
}
