meta {
  name: List transfers (payer, payments)
  type: http
  seq: 13
}

get {
  url: {{paymentUrl}}/transfers?customerId={{payerId}}&type=payment&currency=USD&limit=20
  body: none
  auth: none
}

params:query {
  customerId: {{payerId}}
  type: payment
  currency: USD
  limit: 20
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("only payments", function () {
    expect(res.body.every((t) => t.type === "payment")).to.equal(true);
  });
}
