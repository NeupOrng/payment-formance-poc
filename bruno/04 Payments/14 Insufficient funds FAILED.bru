meta {
  name: Insufficient funds → FAILED
  type: http
  seq: 14
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "40.00",
    "payerStockId": "{{payeeStock}}",
    "payeeStockId": "{{payerStock}}"
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("FAILED at reserve", function () {
    expect(res.body.status).to.equal("FAILED"); expect(res.body.statusReasonCode).to.equal("INSUFFICIENT_FUNDS");
  });
}
