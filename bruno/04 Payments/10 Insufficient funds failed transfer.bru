meta {
  name: Insufficient funds → failed transfer
  type: http
  seq: 10
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "4000",
    "currency": "USD",
    "source": "{{payeeId}}",
    "destination": "{{payerId}}"
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("failed", function () {
    expect(res.body.status).to.equal("failed");
  });

  test("reason", function () {
    expect(res.body.failureReason).to.equal("insufficient_fund");
  });
}

docs {
  The payee holds $20.00 and tries to pay $42.00: the ledger rejects it and nothing moves.
}
