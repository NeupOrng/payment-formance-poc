meta {
  name: Pay $10 for the cancel test
  type: http
  seq: 21
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "10.00",
    "payerStockId": "{{payerStock}}",
    "payeeStockId": "{{payeeStock}}"
  }
}

script:post-response {
  bru.setVar("secondId", res.body.id);
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });
}
