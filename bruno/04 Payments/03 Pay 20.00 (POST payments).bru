meta {
  name: Pay $20.00 (POST /payments)
  type: http
  seq: 3
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "2000",
    "currency": "USD",
    "source": "{{payerId}}",
    "destination": "{{payeeId}}"
  }
}

vars:pre-request {
  payerId: c99f06fe-0c94-408b-9ef1-53dde15832c4
  payeeId: 8d0e7303-1632-4958-9e23-d58de7b27cb5
  serviceCode: P2P_TRANSFER
}

script:pre-request {
  bru.setVar("payKey", bru.getVar("idempotencyKey"));
}

script:post-response {
  bru.setVar("paymentId", res.body.id);
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });
  
  test("posted", function () {
    expect(res.body.status).to.equal("posted");
  });
  
  test("payer pays the selling price", function () {
    expect(res.body.sourceNet).to.equal("-2100");
  });
  
  test("payee receives the amount", function () {
    expect(res.body.destinationNet).to.equal("2000");
  });
  
  test("fee priced at 5%", function () {
    expect(res.body.amounts.find((a) => a.amountType === "fee_from_customer").amount).to.equal("100");
  });
}

docs {
  The caller sends only service, amount, currency, source and destination.
}
