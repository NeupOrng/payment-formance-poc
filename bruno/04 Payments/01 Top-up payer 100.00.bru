meta {
  name: Top-up payer $100.00
  type: http
  seq: 1
}

post {
  url: {{paymentUrl}}/topups
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "customerId": "{{payerId}}",
    "currency": "USD",
    "amount": "10000",
    "externalRef": "bank-{{idempotencyKey}}"
  }
}

vars:pre-request {
  payerId: c99f06fe-0c94-408b-9ef1-53dde15832c4
}

script:pre-request {
  bru.setVar("topupKey", bru.getVar("idempotencyKey"));
}

script:post-response {
  bru.setVar("topupId", res.body.id);
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });
  
  test("posted", function () {
    expect(res.body.status).to.equal("posted");
  });
  
  test("payee side +10000", function () {
    expect(res.body.destinationNet).to.equal("10000");
  });
}

docs {
  Money from the partner bank: @world → customer.
}
