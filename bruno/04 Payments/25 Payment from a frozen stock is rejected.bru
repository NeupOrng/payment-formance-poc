meta {
  name: Payment from a frozen stock is rejected
  type: http
  seq: 25
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "1.00",
    "payerStockId": "{{payerStock}}",
    "payeeStockId": "{{payeeStock}}"
  }
}

tests {
  test("status is 422", function () {
    expect(res.status).to.equal(422);
  });
}
