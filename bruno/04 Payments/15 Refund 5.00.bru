meta {
  name: Refund $5.00
  type: http
  seq: 15
}

post {
  url: {{paymentUrl}}/payments/{{paymentId}}/refund
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "amount": "500"
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("posted", function () {
    expect(res.body.status).to.equal("posted");
  });

  test("payer +500", function () {
    expect(res.body.sourceNet).to.equal("500");
  });
}
