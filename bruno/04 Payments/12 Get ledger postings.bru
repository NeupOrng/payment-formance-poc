meta {
  name: Get ledger postings
  type: http
  seq: 12
}

get {
  url: {{paymentUrl}}/transfers/{{paymentId}}/ledger
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("two postings", function () {
    expect(res.body.postings).to.have.length(2);
  });

  test("debit/credit types", function () {
    expect([res.body.postings[0].debitType, res.body.postings[0].creditType]).to.eql(["selling_price", "amount"]);
  });

  test("fee posting", function () {
    expect(res.body.postings[1].creditType).to.equal("fee_from_customer");
  });
}
