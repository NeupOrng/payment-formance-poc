meta {
  name: Payment to a suspended service is rejected
  type: http
  seq: 25
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "100",
    "currency": "USD",
    "source": "{{payerId}}",
    "destination": "{{payeeId}}"
  }
}

tests {
  test("status is 422", function () {
    expect(res.status).to.equal(422);
  });
}
