meta {
  name: Get transfer
  type: http
  seq: 11
}

get {
  url: {{paymentUrl}}/transfers/{{paymentId}}
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("has events", function () {
    expect(res.body.events.map((e) => e.toStatus)).to.eql(["pending", "posted"]);
  });

  test("has amount types", function () {
    expect(res.body.amounts.length).to.be.greaterThan(2);
  });
}
