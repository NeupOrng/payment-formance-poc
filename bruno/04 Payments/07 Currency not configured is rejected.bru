meta {
  name: Currency not configured is rejected
  type: http
  seq: 7
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "2000",
    "currency": "KHR",
    "source": "{{payerId}}",
    "destination": "{{payeeId}}"
  }
}

tests {
  test("status is 422", function () {
    expect(res.status).to.equal(422);
  });

  test("not configured", function () {
    expect(res.body.message).to.contain("not configured");
  });
}
