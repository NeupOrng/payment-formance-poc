meta {
  name: Top-up replay returns the same transfer
  type: http
  seq: 2
}

post {
  url: {{paymentUrl}}/topups
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{topupKey}}
}

body:json {
  {
    "customerId": "{{payerId}}",
    "currency": "USD",
    "amount": "10000",
    "externalRef": "bank-{{topupKey}}"
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("same id", function () {
    expect(res.body.id).to.equal(bru.getVar("topupId"));
  });
}
