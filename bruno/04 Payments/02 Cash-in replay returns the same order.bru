meta {
  name: Cash-in replay returns the same order
  type: http
  seq: 2
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{cashKey}}
}

body:json {
  {
    "serviceCode": "{{cashCode}}",
    "amount": "100.00",
    "payerStockId": "{{settlementStock}}",
    "payeeStockId": "{{payerStock}}"
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("same id", function () {
    expect(res.body.id).to.equal(bru.getVar("cashId"));
  });
}
