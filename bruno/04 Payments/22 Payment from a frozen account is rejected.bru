meta {
  name: Payment from a frozen account is rejected
  type: http
  seq: 22
}

post {
  url: {{paymentUrl}}/payments
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "amount": "100",
    "currency": "USD",
    "source": "{{payerId}}",
    "destination": "{{payeeId}}"
  }
}

tests {
  test("status is 422", function () {
    expect(res.status).to.equal(422);
  });

  test("frozen", function () {
    expect(res.body.message).to.contain("frozen");
  });
}
