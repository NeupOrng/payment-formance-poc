meta {
  name: Pay $10.00 (generic command endpoint)
  type: http
  seq: 18
}

post {
  url: {{paymentUrl}}/services/{{serviceCode}}/payment
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "amount": "1000",
    "currency": "USD",
    "source": "{{payerId}}",
    "destination": "{{payeeId}}"
  }
}

script:post-response {
  bru.setVar("secondPaymentId", res.body.id);
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("posted", function () {
    expect(res.body.status).to.equal("posted");
  });
}
