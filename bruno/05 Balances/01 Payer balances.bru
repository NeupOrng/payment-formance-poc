meta {
  name: Payer balances
  type: http
  seq: 1
}

get {
  url: {{paymentUrl}}/customers/{{payerId}}/balances
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("USD: 10000 \u2212 2100 + 500 + 1500 \u2212 1050 + 1000 = 9850", function () {
    expect(res.body.find((b) => b.currency === "USD").balance).to.equal("9850");
  });

  test("KHR untouched", function () {
    expect(res.body.find((b) => b.currency === "KHR").balance).to.equal("0");
  });
}
