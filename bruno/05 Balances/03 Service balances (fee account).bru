meta {
  name: Service balances (fee account)
  type: http
  seq: 3
}

get {
  url: {{paymentUrl}}/services/{{serviceCode}}/balances
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("fee account kept $1.00 + $0.50", function () {
    expect(res.body.find((b) => b.account === "platform:fees:{service}" && b.currency === "USD").balance).to.equal("150");
  });
}
