meta {
  name: List services
  type: http
  seq: 3
}

get {
  url: {{paymentUrl}}/services
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("contains the new service", function () {
    expect(res.body.some((s) => s.serviceCode === bru.getVar("serviceCode"))).to.equal(true);
  });
}
