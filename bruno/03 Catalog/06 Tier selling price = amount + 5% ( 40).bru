meta {
  name: Tier: selling price = amount + 5% (≤ $40)
  type: http
  seq: 6
}

post {
  url: {{paymentUrl}}/services/{{serviceCode}}/commands/payment/pricing-tiers
  body: json
  auth: none
}

body:json {
  {
    "amountType": "selling_price",
    "currency": "USD",
    "minAmount": "1",
    "maxAmount": "4000",
    "calcType": "percent",
    "percentBps": 500,
    "includeBase": true
  }
}

script:post-response {
  bru.setVar("sellingTierId", res.body.id);
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("includes base", function () {
    expect(res.body.includeBase).to.equal(true);
  });

  test("no movement yet", function () {
    expect(res.body.movementCheck).to.equal(null);
  });
}
