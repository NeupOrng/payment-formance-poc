meta {
  name: Save balanced movement
  type: http
  seq: 11
}

put {
  url: {{paymentUrl}}/services/{{serviceCode}}/commands/payment/movement
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "entryNo": 1,
        "side": "debit",
        "account": "{source}",
        "amountType": "selling_price"
      },
      {
        "entryNo": 2,
        "side": "credit",
        "account": "{destination}",
        "amountType": "amount"
      },
      {
        "entryNo": 3,
        "side": "credit",
        "account": "platform:fees:{service}",
        "amountType": "fee_from_customer"
      }
    ]
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("balanced", function () {
    expect(res.body.balanced).to.equal(true);
  });

  test("KHR reported as not configured", function () {
    expect(res.body.unconfiguredCurrencies).to.eql(["KHR"]);
  });

  test("3 entries saved", function () {
    expect(res.body.entries).to.have.length(3);
  });
}

docs {
  Debit payer selling price; credit payee amount; credit fee account fee from customer.
}
