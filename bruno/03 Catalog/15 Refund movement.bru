meta {
  name: Refund movement
  type: http
  seq: 15
}

put {
  url: {{paymentUrl}}/services/{{serviceCode}}/commands/refund/movement
  body: json
  auth: none
}

body:json {
  {
    "entries": [
      {
        "entryNo": 1,
        "side": "debit",
        "account": "{destination}",
        "amountType": "amount"
      },
      {
        "entryNo": 2,
        "side": "credit",
        "account": "{source}",
        "amountType": "amount"
      }
    ]
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("balanced", function () {
    expect(res.body.balanced).to.equal(true);
  });
}
