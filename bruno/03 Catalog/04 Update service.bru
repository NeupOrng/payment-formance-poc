meta {
  name: Update service
  type: http
  seq: 4
}

patch {
  url: {{paymentUrl}}/services/{{serviceCode}}
  body: json
  auth: none
}

body:json {
  {
    "serviceName": "Bruno test shop (renamed)"
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("renamed", function () {
    expect(res.body.serviceName).to.contain("renamed");
  });
}
