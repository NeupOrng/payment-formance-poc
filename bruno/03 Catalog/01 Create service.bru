meta {
  name: Create service
  type: http
  seq: 1
}

post {
  url: {{paymentUrl}}/services
  body: json
  auth: none
}

body:json {
  {
    "serviceCode": "{{serviceCode}}",
    "serviceName": "Bruno test shop"
  }
}

script:pre-request {
  bru.setVar("serviceCode", "BRUNO_" + Math.floor(100000 + Math.random() * 900000));
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("active", function () {
    expect(res.body.status).to.equal("active");
  });
}

docs {
  A fresh service per run, so the collection never depends on seeded data.
}
