meta {
  name: Retire that tier
  type: http
  seq: 13
}

patch {
  url: {{paymentUrl}}/pricing-tiers/{{khrTierId}}
  body: json
  auth: none
}

body:json {
  {
    "effectiveTo": "{{now}}"
  }
}

script:pre-request {
  bru.setVar("now", new Date(Date.now() + 1000).toISOString());
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("has effectiveTo", function () {
    expect(res.body.effectiveTo).to.be.a("string");
  });
}
